{
  "name": "spotidraft",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Spotidraft — YouTube to Spotify for Creators drafts",
  "main": "electron/main.js",
  "bin": {
    "spotidraft": "./bin/spotidraft.js"
  },
  "scripts": {
    "start": "node src/server/index.js",
    "login": "node bin/spotidraft.js login",
    "ingest": "node bin/spotidraft.js ingest",
    "package": "node bin/spotidraft.js package",
    "enqueue": "node bin/spotidraft.js enqueue",
    "worker": "node bin/spotidraft.js worker",
    "status": "node bin/spotidraft.js status",
    "server": "node src/server/index.js",
    "dev:web": "npm --prefix web run dev",
    "build:web": "npm --prefix web run build",
    "test": "node --test test/**/*.test.js",
    "electron:yt-dlp": "node scripts/fetch-yt-dlp.mjs",
    "electron:browsers": "node scripts/fetch-playwright-browsers.mjs",
    "electron:prepare": "npm run build:web && npm run electron:icons && npm run electron:yt-dlp && npm run electron:browsers",
    "electron:dev": "npm run build:web && electron .",
    "electron:dist": "npm run electron:prepare && electron-builder --publish never",
    "electron:dist:linux": "npm run electron:prepare && electron-builder --linux AppImage --publish never",
    "electron:dist:win": "npm run electron:prepare && electron-builder --win nsis --publish never",
    "electron:dist:mac": "npm run electron:prepare && electron-builder --mac dmg --publish never",
    "dev:server": "bash scripts/dev-server.sh",
    "electron:icons": "node scripts/make-icons.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "playwright": "^1.55.0"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "app.spotidraft.desktop",
    "productName": "Spotidraft",
    "copyright": "Copyright © Spotidraft",
    "directories": {
      "output": "release",
      "buildResources": "electron/assets"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "bin/**/*",
      "package.json",
      "node_modules/**/*",
      "!node_modules/.cache/**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/.bin/**",
      "electron/assets/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/playwright/**",
      "**/node_modules/playwright-core/**"
    ],
    "extraResources": [
      {
        "from": "web/dist",
        "to": "web/dist"
      },
      {
        "from": "vendor/yt-dlp",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "vendor/ms-playwright",
        "to": "ms-playwright",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo",
      "icon": "electron/assets/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "electron/assets/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "electron/assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  }
}
